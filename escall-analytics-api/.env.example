APP_NAME="ESCALL Analytics API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ANALYTICS_TIMEZONE=America/Lima
EXPERTIS_REPORT_TO="alejandro.romero@goexpertis.com,Gina.Georffino@goexpertis.com"
EXPERTIS_REPORT_CC="katherine.supervision@escallperu.com,cespinozag@escallperu.com"
EXPERTIS_REPORT_TIMEZONE=America/Lima

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=escarperu_software
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:4200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=http://localhost:4200
ANALYTICS_EXPERTIS_TEAM="KATHERINE HUAMAN"
ANALYTICS_IMPORT_MAX_MB=150
ANALYTICS_IMPORT_MAX_ROWS=500000
ANALYTICS_IMPORT_CHUNK_SIZE=1200
ANALYTICS_PAYMENT_IMPORT_CHUNK_SIZE=2000
ANALYTICS_IMPORT_MAX_UNCOMPRESSED_MB=1024

# Production: SESSION_DOMAIN=.escallperu.com, SESSION_SECURE_COOKIE=true,
# SANCTUM_STATEFUL_DOMAINS=analytics.escallperu.com, and CORS_ALLOWED_ORIGINS=https://analytics.escallperu.com
